# Copia a .env (local) o define en Railway. Nunca subas valores reales.
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+psycopg://srr@localhost:5433/srr
# Clave de TypeSafe (solo backend; nunca en variables VITE_*)
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_SECONDS=15
JEV_MAX_RETRIES=2
JEV_MAX_CONCURRENCY=4
JEV_ARTICLE_BUDGET_SECONDS=60
# Acceso de presentador: contraseña compartida y secreto de firma de cookies (genera valores largos aleatorios)
ADMIN_PASSWORD=
SESSION_SECRET=
# URL pública https en Railway (activa cookies Secure y HSTS)
APP_BASE_URL=http://localhost:8000
APP_TIMEZONE=Europe/Madrid
RISK_POLICY_PATH=config/risk_policy.json
RSS_CONFIG_PATH=config/rss_sources.json
RSS_POLL_SECONDS=300
RSS_DAILY_ANALYSIS_BUDGET=100
RSS_ENABLED=true
WORKER_THREADS=4
IMPORT_MAX_BYTES=10485760
IMPORT_MAX_ROWS=5000
# Modo fixture explícito, solo para desarrollo de interfaz sin clave (resultados no exportables)
DEMO_FIXTURES_ENABLED=false
# Generador opcional de texto: template | ollama | compatible
EXPLANATION_PROVIDER=template
OLLAMA_BASE_URL=
OLLAMA_MODEL=
GENERATOR_BASE_URL=
GENERATOR_API_KEY=
GENERATOR_MODEL=
# Railway inyecta PORT. Usa 8000 en local.
PORT=8000
